# Server Configuration
PORT=3001
NODE_ENV=development

# Session Configuration
SESSION_SECRET=your-secret-key-change-in-production

# Dev: skip LoginPage — auto-auth as DEV_USERNAME (ignored when NODE_ENV=production)
